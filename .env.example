# —— ABíbliaDigital (ACF / RA / NVI) — optional Bearer token ——
# Without a token the public rate limit is 20 requests/hour/IP.
# With a token, requests are unlimited (free). Create a user via
# POST https://www.abibliadigital.com.br/api/users and paste the JWT here.
# On Cloudflare Pages: Settings → Environment variables → Production
#   Name: VITE_ABIBLIA_TOKEN   Value: <jwt>   (also set for Preview if needed)
# Then trigger a new deploy so Vite inlines the value at build time.
# VITE_ABIBLIA_TOKEN=
# Alias also accepted:
# VITE_ABIBLIA_DIGITAL_TOKEN=

# —— Licensed Portuguese versions (NVT / ARC current / fallback NVI) ——
# Never scrape or embed. Enable only with a licensed Bible API key.
# Keys must not be committed.

# VITE_BIBLE_API_ENABLED=true
# VITE_BIBLE_API_PROVIDER=api.bible
#   # or: dbp  (Digital Bible Platform / Faith Comes By Hearing)
# VITE_BIBLE_API_KEY=your_api_key_here

# Provider bible ids for each catalog entry (from your API dashboard):
# VITE_BIBLE_API_BIBLE_NVI=
# VITE_BIBLE_API_BIBLE_NVT=
# VITE_BIBLE_API_BIBLE_ARC=
